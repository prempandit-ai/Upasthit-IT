generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT
  FACULTY
  HOD
  COORDINATOR
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubjectType {
  THEORY
  PRACTICAL
  ELECTIVE
  AUDIT
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum Year {
  FY
  SY
  TY
  BE
}

enum AttendanceSessionStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum TimetableSessionType {
  LECTURE
  LAB
  TUTORIAL
}

enum AcademicAssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudyPlanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeaveRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SENT_BACK
}

enum CampusEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
}

enum StudentDocumentStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum FeePaymentStatus {
  RECORDED
  VOID
}

// ─── Core Auth Table (UNCHANGED) ─────────────────────────────────────────────

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  password           String
  role               Role
  status             AccountStatus @default(PENDING)
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  tokenVersion       Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Profile relations (1:1 per role)
  studentProfile     StudentProfile?
  facultyProfile     FacultyProfile?
  hodProfile         HODProfile?
  coordinatorProfile CoordinatorProfile?
  adminProfile       AdminProfile?

  notifications       StudentNotification[]
  authoredAssignments AcademicAssignment[] @relation("AssignmentAuthor")
  leaveReviews        LeaveRequestReview[] @relation("LeaveReviewer")
  createdTimetables   TimetableEntry[] @relation("TimetableCreator")
  createdEvents       CampusEvent[] @relation("EventCreator")
  reviewedDocuments   StudentDocument[] @relation("DocumentReviewer")
  createdFeeCharges   StudentFeeCharge[] @relation("FeeChargeCreator")
  issuedLibraryLoans  LibraryLoan[] @relation("LibraryIssuer")
  receivedLibraryLoans LibraryLoan[] @relation("LibraryReturner")

  // Approval audit
  approvalsMade     ApprovalLog[] @relation("ReviewerApprovals")
  approvalsReceived ApprovalLog[] @relation("TargetApprovals")
}

// ─── Department (Reference Table) ─────────────────────────────────────────────

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique // e.g. "CE", "IT", "ME"
  name      String // e.g. "Computer Engineering"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students     StudentProfile[]
  faculty      FacultyProfile[]
  hods         HODProfile[]
  coordinators CoordinatorProfile[]
  subjects     Subject[]
}

// ─── Student Profile ──────────────────────────────────────────────────────────

model StudentProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId        String           @unique // GR Number
  rollNo           Int?
  enrollmentNo     String?          @unique
  mobileNumber     String?
  gender           String? // e.g. "Male", "Female", "Other"
  enrollmentStatus EnrollmentStatus @default(ACTIVE)
  program          String? // e.g. "B.Tech", "B.E."
  dateOfBirth      DateTime?
  bloodGroup       String?
  nationality      String?
  fatherName       String?
  motherName       String?
  address          String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  departmentId   Int?
  department     Department? @relation(fields: [departmentId], references: [id])
  departmentCode String // kept for backward compat / Excel import
  departmentName String

  academicYear String // e.g. "2025-26"
  semester     Int // 1–8
  division     String? // A, B, C
  labBatch     String? // A1-A3 or B1-B3; null until allocated
  year         Year // FY, SY, TY, BE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjectEnrollments StudentSubjectEnrollment[]
  attendanceRecords  AttendanceRecord[]
  assignmentSubmissions AssignmentSubmission[]
  leaveRequests       LeaveRequest[]
  eventRegistrations  EventRegistration[]
  documents           StudentDocument[]
  feeCharges          StudentFeeCharge[]
  feePayments         StudentFeePayment[]
  libraryLoans        LibraryLoan[]

  @@index([departmentId])
  @@index([academicYear, semester])
  @@index([year, division])
}

// ─── Faculty Profile ──────────────────────────────────────────────────────────

model FacultyProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId   String  @unique
  mobileNumber String?
  designation  String?

  departmentId   Int?
  department     Department? @relation(fields: [departmentId], references: [id])
  departmentName String // kept for backward compat / Excel import

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjectAssignments FacultySubjectAssignment[]
  timetableEntries   TimetableEntry[]
  academicAssignments AcademicAssignment[]
  studyPlans         StudyPlan[]
  eventAssignments   EventFacultyAssignment[]

  @@index([departmentId])
}

// ─── HOD Profile ──────────────────────────────────────────────────────────────

model HODProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId String @unique

  departmentId   Int?
  department     Department? @relation(fields: [departmentId], references: [id])
  departmentName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Coordinator Profile ──────────────────────────────────────────────────────

model CoordinatorProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId String @unique

  departmentId   Int?
  department     Department? @relation(fields: [departmentId], references: [id])
  departmentName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Admin Profile ────────────────────────────────────────────────────────────

model AdminProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Subject ──────────────────────────────────────────────────────────────────

model Subject {
  id          Int         @id @default(autoincrement())
  subjectCode String      @unique
  subjectName String
  subjectType SubjectType @default(THEORY)
  credits     Int?

  departmentId   Int?
  department     Department? @relation(fields: [departmentId], references: [id])
  departmentCode String // backward compat

  academicYear String // e.g. "2025-26"
  semester     Int
  year         Year // FY, SY, TY, BE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facultyAssignments FacultySubjectAssignment[]
  studentEnrollments StudentSubjectEnrollment[]
  timetableEntries   TimetableEntry[]
  academicAssignments AcademicAssignment[]
  studyPlans         StudyPlan[]

  @@index([departmentId, semester, academicYear])
}

// ─── Faculty–Subject Assignment ───────────────────────────────────────────────

model FacultySubjectAssignment {
  id Int @id @default(autoincrement())

  facultyId Int
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  academicYear String
  division     String? // A, B, C — null means all divisions

  createdAt          DateTime            @default(now())
  attendanceSessions AttendanceSession[]

  @@unique([facultyId, subjectId, academicYear, division])
  @@index([facultyId])
  @@index([subjectId])
}

// ─── Student–Subject Enrollment ───────────────────────────────────────────────

model StudentSubjectEnrollment {
  id Int @id @default(autoincrement())

  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  academicYear String
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())

  @@unique([studentId, subjectId, academicYear])
  @@index([studentId])
  @@index([subjectId])
}

// ─── Approval Log ─────────────────────────────────────────────────────────────

model ApprovalLog {
  id Int @id @default(autoincrement())

  targetId String
  target   User   @relation("TargetApprovals", fields: [targetId], references: [id])

  reviewerId String?
  reviewer   User?   @relation("ReviewerApprovals", fields: [reviewerId], references: [id])

  action AccountStatus // APPROVED or REJECTED
  note   String? // optional rejection reason

  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([reviewerId])
}

// ─── Attendance Session ───────────────────────────────────────────────────────

model AttendanceSession {
  id                    Int                     @id @default(autoincrement())
  assignmentId          Int
  academicYear          String
  year                  Year
  division              String
  sessionDate           DateTime
  status                AttendanceSessionStatus @default(NOT_STARTED)
  attendanceType        String?
  sessionType           String?
  labBatch              String?
  lectureTime           String?
  startedAt             DateTime?
  expiresAt             DateTime?
  completedAt           DateTime?
  windowDurationSeconds Int                     @default(300)
  joinCode              String?                 @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  assignment FacultySubjectAssignment @relation(fields: [assignmentId], references: [id])
  records    AttendanceRecord[]

  @@index([assignmentId, sessionDate])
  @@index([status, expiresAt])
}

// ─── Attendance Record ────────────────────────────────────────────────────────

model AttendanceRecord {
  id        Int              @id @default(autoincrement())
  sessionId Int
  studentId Int
  status    AttendanceStatus
  markedAt  DateTime         @default(now())

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile    @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model TimetableEntry {
  id           Int                  @id @default(autoincrement())
  academicYear String
  year         Year
  semester     Int
  division     String
  labBatch     String?
  dayOfWeek    Int
  startTime    String
  endTime      String
  room         String?
  sessionType  TimetableSessionType
  subjectId    Int
  facultyId    Int
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  createdBy User          @relation("TimetableCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([academicYear, year, semester, division, dayOfWeek])
  @@index([facultyId, dayOfWeek])
}

model AcademicAssignment {
  id               Int                       @id @default(autoincrement())
  subjectId        Int
  facultyId        Int
  authorUserId     String
  academicYear     String
  year             Year
  semester         Int
  division         String?
  labBatch         String?
  title            String
  description      String?
  attachmentUrl    String?
  attachmentName  String?
  dueAt            DateTime
  maxMarks         Decimal?                  @db.Decimal(8, 2)
  status           AcademicAssignmentStatus  @default(DRAFT)
  allowResubmission Boolean                 @default(false)
  publishedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  subject     Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty     FacultyProfile         @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  author      User                   @relation("AssignmentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  submissions AssignmentSubmission[]

  @@index([facultyId, status, dueAt])
  @@index([academicYear, year, semester, division, labBatch, status])
}

model AssignmentSubmission {
  id               Int       @id @default(autoincrement())
  assignmentId     Int
  studentId        Int
  responseText     String?
  attachmentUrl    String?
  attachmentName  String?
  submittedAt      DateTime  @default(now())
  marks            Decimal?  @db.Decimal(8, 2)
  feedback         String?
  feedbackReleased Boolean   @default(false)
  updatedAt        DateTime  @updatedAt

  assignment AcademicAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
}

model StudyPlan {
  id           Int            @id @default(autoincrement())
  subjectId    Int
  facultyId    Int
  academicYear String
  year         Year
  semester     Int
  division     String?
  title        String
  description  String?
  fileUrl      String?
  fileName     String?
  version      Int            @default(1)
  status       StudyPlanStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@unique([subjectId, academicYear, year, semester, version])
  @@index([academicYear, year, semester, division, status])
}

model LeaveRequest {
  id          Int               @id @default(autoincrement())
  studentId   Int
  leaveType   String
  clientRequestId String?
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  reason      String
  attachmentUrl String?
  status      LeaveRequestStatus @default(PENDING)
  submittedAt DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  student StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviews LeaveRequestReview[]

  @@index([studentId, submittedAt])
  @@index([status, submittedAt])
  @@unique([studentId, clientRequestId])
}

model LeaveRequestReview {
  id             Int      @id @default(autoincrement())
  leaveRequestId Int
  reviewerId     String
  action         String
  remarks        String?
  createdAt      DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  reviewer     User         @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([leaveRequestId, createdAt])
}

model CampusEvent {
  id                    Int              @id @default(autoincrement())
  createdById           String
  name                  String
  category              String?
  description           String?
  organizer             String?
  venue                 String?
  startsAt              DateTime
  endsAt                DateTime?
  registrationOpensAt   DateTime?
  registrationDeadline DateTime?
  cancellationDeadline DateTime?
  capacity              Int?
  allowCancellation     Boolean          @default(false)
  targetAcademicYear    String?
  targetYear            Year?
  targetDivision        String?
  targetLabBatch        String?
  status                CampusEventStatus @default(DRAFT)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  createdBy     User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  registrations EventRegistration[]
  facultyAssignments EventFacultyAssignment[]

  @@index([status, startsAt])
  @@index([targetAcademicYear, targetYear, targetDivision, targetLabBatch])
}

model EventRegistration {
  id           Int                     @id @default(autoincrement())
  eventId      Int
  studentId    Int
  status       EventRegistrationStatus @default(REGISTERED)
  registeredAt DateTime                @default(now())
  cancelledAt  DateTime?

  event   CampusEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([studentId, status])
}

model EventFacultyAssignment {
  id             Int      @id @default(autoincrement())
  eventId        Int
  facultyId      Int
  responsibility String
  createdAt      DateTime @default(now())

  event   CampusEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  faculty FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([eventId, facultyId])
  @@index([facultyId])
}

model StudentNotification {
  id          String   @id @default(cuid())
  recipientId String
  type        String
  title       String
  body        String
  dedupeKey   String
  relatedUrl  String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
}

model StudentDocument {
  id             Int                  @id @default(autoincrement())
  studentId      Int
  title          String
  documentType   String
  fileName       String
  mimeType       String
  sizeBytes      BigInt
  fileUrl        String
  status         StudentDocumentStatus @default(SUBMITTED)
  reviewerId     String?
  reviewerRemarks String?
  submittedAt    DateTime             @default(now())
  reviewedAt     DateTime?

  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer User?          @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([studentId, submittedAt])
}

model StudentFeeCharge {
  id           Int      @id @default(autoincrement())
  studentId    Int
  createdById  String
  title        String
  academicYear String
  amount       Decimal  @db.Decimal(12, 2)
  dueDate      DateTime? @db.Date
  createdAt    DateTime @default(now())

  student   StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("FeeChargeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payments  StudentFeePayment[]

  @@index([studentId, academicYear, dueDate])
}

model StudentFeePayment {
  id            Int              @id @default(autoincrement())
  studentId     Int
  chargeId      Int?
  receiptNumber String           @unique
  amount        Decimal          @db.Decimal(12, 2)
  paymentMethod String?
  paidAt        DateTime         @default(now())
  status        FeePaymentStatus @default(RECORDED)
  receiptUrl    String?

  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charge  StudentFeeCharge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([studentId, paidAt])
}

model LibraryBook {
  id            Int      @id @default(autoincrement())
  isbn          String?  @unique
  accessionCode String?  @unique
  title         String
  author        String?
  publisher     String?
  category      String?
  totalCopies   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loans LibraryLoan[]
}

model LibraryLoan {
  id           Int       @id @default(autoincrement())
  bookId       Int
  studentId    Int
  issuedById   String
  returnedToId String?
  issuedAt     DateTime  @default(now())
  dueAt        DateTime
  returnedAt   DateTime?

  book       LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy   User          @relation("LibraryIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  returnedTo User?         @relation("LibraryReturner", fields: [returnedToId], references: [id], onDelete: SetNull)

  @@index([studentId, returnedAt, dueAt])
  @@index([bookId, returnedAt])
}

model LibraryPolicy {
  id                Int      @id @default(1)
  maxActiveLoans    Int      @default(0)
  finePerDay        Decimal? @db.Decimal(8, 2)
  updatedAt         DateTime @updatedAt
}
