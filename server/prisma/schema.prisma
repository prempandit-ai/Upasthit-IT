generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  FACULTY
  HOD
  COORDINATOR
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  password  String
  role      Role
  status    AccountStatus @default(PENDING)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
